# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=your-coturn-shared-auth-secret
# Or provider-issued ICE servers (never commit real credentials):
# ICE_SERVERS_JSON=[{"urls":"turns:turn.example.com:443","username":"example","credential":"example"}]
