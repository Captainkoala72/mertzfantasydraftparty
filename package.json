{
  "name": "mertz-invitational-draft-party",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One shared, account-free WebRTC draft party.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
